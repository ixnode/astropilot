---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SiteConfig } from '../../../lib/astropilot/types';
import { canonicalUrl } from '../../../lib/astropilot/urls';
interface Props { site: SiteConfig; title: string; description: string; route: string; }
const { site, title, description, route } = Astro.props;
const documentTitle = `${title} | ${site.name}`;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl(route, site)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <Header site={site} route={route} />
    <main id="main-content"><slot /></main>
    <Footer site={site} />
  </body>
</html>
