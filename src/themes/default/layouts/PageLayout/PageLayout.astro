---
import '../../styles/theme.css';
import faviconUrl from '../../assets/favicon.svg?url';
import Header from '../../components/organisms/Header/Header.astro';
import Footer from '../../components/organisms/Footer/Footer.astro';
import type { SiteConfig } from '../../../../lib/astropilot/types.js';
import { canonicalUrl } from '../../../../lib/astropilot/urls.js';
interface Props {
    site: SiteConfig;
    title: string;
    description: string;
    route: string;
}
const { site, title, description, route } = Astro.props;
const documentTitle = `${title} | ${site.name}`;
---

<!doctype html>
<html lang={site.language} data-theme="astropilot">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" sizes="any" href={faviconUrl} />
        <title>{documentTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl(route, site)} />
    </head>
    <body>
        <a class="ap-skip-link" href="#main-content">
            Zum Inhalt springen
        </a>
        <Header site={site} route={route} />
        <main id="main-content">
            <slot />
        </main>
        <Footer site={site} />
    </body>
</html>
