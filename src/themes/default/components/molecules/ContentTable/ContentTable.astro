---
interface Props {
    caption: string;
    variant?: 'plain' | 'striped';
    density?: 'comfortable' | 'compact';
    wide?: boolean;
    highlight?: number;
}

const {
    caption,
    variant = 'plain',
    density = 'comfortable',
    wide = false,
    highlight,
} = Astro.props;
if (
    !caption?.trim() ||
    !['plain', 'striped'].includes(variant) ||
    !['comfortable', 'compact'].includes(density) ||
    typeof wide !== 'boolean' ||
    (highlight !== undefined && (!Number.isInteger(highlight) || highlight < 1))
)
    throw new Error(
        'ContentTable requires a caption; variant is plain or striped, density is comfortable or compact, wide is boolean, and highlight is a positive row number.',
    );
---

<div
    class:list={[
        'ss-content-table',
        'not-prose',
        variant === 'striped' && 'ss-content-table--striped',
        density === 'compact' && 'ss-content-table--compact',
        wide && 'ss-content-table--wide',
    ]}
    role="region"
    aria-label={`Tabellenbereich: ${caption}`}
    tabindex="0"
>
    <slot />
</div>
