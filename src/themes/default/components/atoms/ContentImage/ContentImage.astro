---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Shape = 'rounded' | 'square';
type Border = 'default' | 'none';

interface Props {
    src: ImageMetadata;
    alt: string;
    width?: number;
    height?: number;
    fullWidth?: boolean;
    shape?: Shape;
    border?: Border;
}

const {
    src,
    alt,
    width,
    height,
    fullWidth = false,
    shape = 'rounded',
    border = 'none',
} = Astro.props;
---

<Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
    class:list={[
        'ap-content-image',
        fullWidth && 'ap-content-image--full',
        shape === 'rounded'
            ? 'ap-content-image--rounded'
            : 'ap-content-image--square',
        border === 'default' && 'ap-content-image--bordered',
    ]}
/>
