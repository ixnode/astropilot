---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Shape = 'rounded' | 'square';
type Border = 'default' | 'none';

/** An optimized local Astro image with content-focused display options. */
interface Props {
    /** Imported Astro image metadata. */
    src: ImageMetadata;
    /** Meaningful alternative text for the image. */
    alt: string;
    /** Optional rendered width in pixels. */
    width?: number;
    /** Optional rendered height in pixels; combines with width for a cover crop. */
    height?: number;
    /** Makes the image fill the available content width. */
    fullWidth?: boolean;
    /** Corner treatment. */
    shape?: Shape;
    /** Optional visible image border. */
    border?: Border;
}

const {
    src,
    alt,
    width,
    height,
    fullWidth = false,
    shape = 'rounded',
    border = 'none',
} = Astro.props;
---

<Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
    class:list={[
        'ss-content-image',
        fullWidth && 'ss-content-image--full',
        shape === 'rounded'
            ? 'ss-content-image--rounded'
            : 'ss-content-image--square',
        border === 'default' && 'ss-content-image--bordered',
    ]}
/>
