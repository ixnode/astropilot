---
type ButtonVariant =
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'neutral'
    | 'info'
    | 'success'
    | 'warning'
    | 'error';
type ButtonStyle = 'solid' | 'outline' | 'soft' | 'ghost' | 'link';
type ButtonSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl';
type ButtonType = 'button' | 'submit' | 'reset';

/** A DaisyUI-styled link or native button with a default slot for its label. */
interface Props {
    /** Semantic color variant. */
    variant?: ButtonVariant;
    /** Visual treatment independent of the color variant. */
    style?: ButtonStyle;
    /** Button size. */
    size?: ButtonSize;
    /** When set, the component renders an anchor instead of a button. */
    href?: string;
    /** Native button type for button actions. */
    type?: ButtonType;
    /** Disables a native button. Links cannot be disabled. */
    disabled?: boolean;
}

const {
    variant = 'primary',
    style = 'solid',
    size = 'md',
    href,
    type = 'button',
    disabled = false,
} = Astro.props;

if (href && disabled)
    throw new Error('AstroPilot Button links cannot be disabled.');

const variantClasses: Record<ButtonVariant, string> = {
    primary: 'btn-primary',
    secondary: 'btn-secondary',
    accent: 'btn-accent',
    neutral: 'btn-neutral',
    info: 'btn-info',
    success: 'btn-success',
    warning: 'btn-warning',
    error: 'btn-error',
};
const styleClasses: Record<ButtonStyle, string> = {
    solid: '',
    outline: 'btn-outline',
    soft: 'btn-soft',
    ghost: 'btn-ghost',
    link: 'btn-link',
};
const sizeClasses: Record<ButtonSize, string> = {
    xs: 'btn-xs',
    sm: 'btn-sm',
    md: 'btn-md',
    lg: 'btn-lg',
    xl: 'btn-xl',
};
const classes = [
    'ap-button',
    'btn',
    'not-prose',
    variantClasses[variant],
    styleClasses[style],
    sizeClasses[size],
];
---

{href ? (
    <a class:list={classes} href={href}>
        {/* @slot Button label or other inline content. */}
        <slot />
    </a>
) : (
    <button class:list={classes} type={type} disabled={disabled}>
        <slot />
    </button>
)}
