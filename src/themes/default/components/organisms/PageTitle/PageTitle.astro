---
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';

interface Props {
    title: string;
    classes: string[];
    eyebrow?: string;
    description?: string;
    variant?: 'compact' | 'hero';
}

const {
    title,
    classes,
    eyebrow,
    description,
    variant = 'compact',
} = Astro.props;
---

<section
    class:list={[
        'tone-brand',
        'ss-hero',
        'ss-page-title',
        `ss-page-title--${variant}`,
        ...classes,
    ]}
    aria-labelledby="page-title"
>
    <div class="ss-hero__inner ss-page-title__inner site-shell">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h1 id="page-title" class="ss-hero__title ss-page-title__title">
            {title}
        </h1>
        {description && <p class="ss-page-title__description">{description}</p>}
    </div>
</section>
