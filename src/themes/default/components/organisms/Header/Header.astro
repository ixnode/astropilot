---
import BrandLogo from '../../atoms/BrandLogo/BrandLogo.astro';
import type { Link, SiteConfig } from '../../../../../lib/sproutsite/types.js';
import {
    contentHref,
    isExternalWebLink,
} from '../../../../../lib/sproutsite/urls.js';

interface Props {
    site: SiteConfig;
    route: string;
}
const { site, route } = Astro.props;
const isActive = (link: Link) => link.href === route;
---

<header class="ss-header">
    <div class="ss-header__inner site-shell">
        <a class="ss-header__brand" href={contentHref('/', site)}>
            <BrandLogo name={site.name} />
        </a>
        <nav class="ss-header__nav" aria-label="Hauptnavigation">
            <ul class="ss-header__links">
                {site.header.links.map((link) => {
                    const external = isExternalWebLink(link.href, site.url);
                    return (
                        <li>
                            <a
                                class="ss-header__link btn btn-ghost btn-sm"
                                href={contentHref(link.href, site)}
                                target={external ? '_blank' : undefined}
                                rel={
                                    external ? 'noopener noreferrer' : undefined
                                }
                                aria-current={
                                    isActive(link) ? 'page' : undefined
                                }
                            >
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
    </div>
</header>

<script>
    const scrollThreshold = 6;
    const header = document.querySelector<HTMLElement>('.ss-header');

    if (header) {
        const updateHeaderState = () => {
            header.classList.toggle(
                'ss-header--scrolled',
                window.scrollY >= scrollThreshold,
            );
        };

        updateHeaderState();
        window.addEventListener('scroll', updateHeaderState, {
            passive: true,
        });
    }
</script>
