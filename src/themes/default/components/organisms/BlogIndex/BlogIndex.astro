---
import type { CollectionEntry } from 'astro:content';
import {
    blogRouteFromId,
    contentHref,
} from '../../../../../lib/sproutsite/urls.js';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import PageLayout from '../../../layouts/PageLayout/PageLayout.astro';
import Card from '../../molecules/Card/Card.astro';
import CardActions from '../../molecules/CardActions/CardActions.astro';
import PageTitle from '../PageTitle/PageTitle.astro';

interface Props {
    posts: CollectionEntry<'blogPages'>[];
    site: SiteConfig;
}

const { posts, site } = Astro.props;
const blog = site.blog ?? {
    title: 'Blog',
    description:
        'Projektfortschritt, Entscheidungen und Meilensteine auf dem Weg zu einem dateibasierten Content-Framework.',
    eyebrow: 'Projektjournal',
    heading: 'Sproutsite im Fortschritt',
};
const dateFormatter = new Intl.DateTimeFormat(site.language, {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
});
---

<PageLayout
    site={site}
    title={blog.title}
    description={blog.description}
    route="/blog/"
>
    <PageTitle
        title={blog.title}
        eyebrow={blog.eyebrow}
        description={blog.description}
        classes={site.heroClasses}
        variant="hero"
    />
    <section
        class="tone-default ss-section ss-blog-index"
        aria-labelledby="blog-overview"
    >
        <div class="ss-section__inner site-shell">
            <div class="content-prose ss-blog-index__content">
                <h2 id="blog-overview">{blog.heading}</h2>
                <div class="ss-blog-index__grid">
                    {posts.map((post) => (
                        <Card
                            image={post.data.image}
                            imageAlt={post.data.imageAlt}
                        >
                            <time
                                class="ss-blog-index__date"
                                datetime={post.data.pubDate.toISOString()}
                            >
                                {dateFormatter.format(post.data.pubDate)}
                            </time>
                            <h2 class="card-title">{post.data.title}</h2>
                            <p>{post.data.description}</p>
                            <CardActions>
                                <a
                                    href={contentHref(
                                        blogRouteFromId(post.id),
                                        site,
                                    )}
                                >
                                    Mehr erfahren
                                </a>
                            </CardActions>
                        </Card>
                    ))}
                </div>
            </div>
        </div>
    </section>
</PageLayout>
