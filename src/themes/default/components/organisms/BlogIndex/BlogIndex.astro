---
import type { CollectionEntry } from 'astro:content';
import {
    blogRouteFromId,
    contentHref,
} from '../../../../../lib/astropilot/urls.js';
import type { SiteConfig } from '../../../../../lib/astropilot/types.js';
import PageLayout from '../../../layouts/PageLayout/PageLayout.astro';
import Card from '../../molecules/Card/Card.astro';
import CardActions from '../../molecules/CardActions/CardActions.astro';
import PageTitle from '../PageTitle/PageTitle.astro';

interface Props {
    posts: CollectionEntry<'blog'>[];
    site: SiteConfig;
}

const { posts, site } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(site.language, {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
});
---

<PageLayout
    site={site}
    title="Blog"
    description="Projektfortschritt, Entscheidungen und Meilensteine von AstroPilot."
    route="/blog/"
>
    <PageTitle title="Blog" classes={site.heroClasses} />
    <section
        class="tone-default ap-section ap-blog-index"
        aria-labelledby="blog-overview"
    >
        <div class="ap-section__inner site-shell">
            <div class="content-prose ap-blog-index__content">
                <p class="ap-eyebrow">Projektjournal</p>
                <h2 id="blog-overview">AstroPilot im Fortschritt</h2>
                <div class="ap-blog-index__grid">
                    {posts.map((post) => (
                        <Card
                            image={post.data.image}
                            imageAlt={post.data.imageAlt}
                        >
                            <time
                                class="ap-blog-index__date"
                                datetime={post.data.pubDate.toISOString()}
                            >
                                {dateFormatter.format(post.data.pubDate)}
                            </time>
                            <h2 class="card-title">{post.data.title}</h2>
                            <p>{post.data.description}</p>
                            <CardActions>
                                <a
                                    href={contentHref(
                                        blogRouteFromId(post.id),
                                        site,
                                    )}
                                >
                                    Mehr erfahren
                                </a>
                            </CardActions>
                        </Card>
                    ))}
                </div>
            </div>
        </div>
    </section>
</PageLayout>
