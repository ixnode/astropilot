---
import type { CollectionEntry } from 'astro:content';
import { toneOf } from '../../../../../lib/astropilot/pages.js';
import type { SiteConfig } from '../../../../../lib/astropilot/types.js';
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';

interface Props {
    hero: CollectionEntry<'documents'>;
    site: SiteConfig;
    Content: Awaited<
        ReturnType<typeof import('astro:content').render>
    >['Content'];
}
const { hero, site, Content } = Astro.props;
const toneClass = {
    default: 'tone-default',
    muted: 'tone-muted',
    brand: 'tone-brand',
}[toneOf(hero)];
const heroClasses =
    hero.data.classes === undefined
        ? site.heroClasses
        : (hero.data.classes ?? []);
---

<section
    class:list={[toneClass, 'ap-hero', ...heroClasses]}
    aria-labelledby="page-title"
>
    <div class="ap-hero__inner site-shell">
        {hero.data.eyebrow && <Eyebrow>{hero.data.eyebrow}</Eyebrow>}
        <h1 id="page-title" class="ap-hero__title">
            {hero.data.title}
        </h1>
        <div class="ap-hero__content content-prose">
            <Content />
        </div>
    </div>
</section>
