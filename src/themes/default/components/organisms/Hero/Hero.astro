---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { toneOf } from '../../../../../lib/sproutsite/pages.js';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';

interface Props {
    hero: CollectionEntry<'documents' | 'blogDocuments'>;
    site: SiteConfig;
    Content: Awaited<
        ReturnType<typeof import('astro:content').render>
    >['Content'];
}
const { hero, site, Content } = Astro.props;
const toneClass = {
    default: 'tone-default',
    muted: 'tone-muted',
    brand: 'tone-brand',
}[toneOf(hero)];
const heroClasses =
    hero.data.classes === undefined
        ? site.heroClasses
        : (hero.data.classes ?? []);
const backgroundImage = hero.data['background-image'];
---

<section
    class:list={[
        toneClass,
        'ss-hero',
        { 'ss-hero--has-background-image': Boolean(backgroundImage) },
        ...heroClasses,
    ]}
    aria-labelledby="page-title"
>
    {backgroundImage && (
        <Image
            class="ss-hero__background"
            src={backgroundImage}
            alt=""
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            aria-hidden="true"
        />
    )}
    <div class="ss-hero__inner site-shell">
        {hero.data.eyebrow && <Eyebrow>{hero.data.eyebrow}</Eyebrow>}
        <h1 id="page-title" class="ss-hero__title">
            {hero.data.title}
        </h1>
        <slot name="meta" />
        <div class="ss-hero__content content-prose">
            <Content />
        </div>
    </div>
</section>
