---
import type { CollectionEntry } from 'astro:content';
import { toneOf } from '../../../../../lib/astropilot/pages';

interface Props {
    hero: CollectionEntry<'documents'>;
    Content: Awaited<
        ReturnType<typeof import('astro:content').render>
    >['Content'];
}
const { hero, Content } = Astro.props;
const toneClass = {
    default: 'tone-default',
    muted: 'tone-muted',
    brand: 'tone-brand',
}[toneOf(hero)];
---

<section
    class:list={[toneClass, 'ap-hero', ...(hero.data.classes ?? [])]}
    aria-labelledby="page-title"
>
    <div class="ap-hero__inner site-shell">
        {hero.data.eyebrow && (
            <p class="ap-hero__eyebrow">{hero.data.eyebrow}</p>
        )}
        <h1 id="page-title" class="ap-hero__title">
            {hero.data.title}
        </h1>
        <div class="ap-hero__content content-prose">
            <Content />
        </div>
    </div>
</section>
