---
import type { CollectionEntry } from 'astro:content';
import { toneOf } from '../../../../../lib/sproutsite/pages.js';

interface Props {
    section: CollectionEntry<'documents' | 'blogDocuments'>;
    Content: Awaited<
        ReturnType<typeof import('astro:content').render>
    >['Content'];
}
const { section, Content } = Astro.props;
const toneClass = {
    default: 'tone-default',
    muted: 'tone-muted',
    brand: 'tone-brand',
}[toneOf(section)];
---

<section class:list={[toneClass, 'ss-section']}>
    <div class="ss-section__inner site-shell">
        <div
            class:list={[
                'content-prose',
                !section.data.fullWidth && 'ss-section__content',
            ]}
        >
            <Content />
        </div>
    </div>
</section>
