---
import BrandLogo from '../../atoms/BrandLogo/BrandLogo.astro';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import {
    contentHref,
    isExternalWebLink,
} from '../../../../../lib/sproutsite/urls.js';
interface Props {
    site: SiteConfig;
}
const { site } = Astro.props;
---

<footer class="ss-footer">
    <div class="ss-footer__inner site-shell">
        <div class="ss-footer__text">
            <a
                href={contentHref('/', site)}
                aria-label={`${site.name}: Startseite`}
            >
                <BrandLogo name={site.name} />
            </a>
            <span>{site.footer.text}</span>
        </div>
        <nav aria-label="Fußnavigation">
            <ul class="ss-footer__links">
                {site.footer.links.map((link) => {
                    const external = isExternalWebLink(link.href, site.url);
                    return (
                        <li>
                            <a
                                href={contentHref(link.href, site)}
                                target={external ? '_blank' : undefined}
                                rel={
                                    external ? 'noopener noreferrer' : undefined
                                }
                            >
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
    </div>
</footer>
