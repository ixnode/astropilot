---
import logoUrl from '../../../assets/favicon.svg?url';
import type { SiteConfig } from '../../../../../lib/astropilot/types';
import { contentHref } from '../../../../../lib/astropilot/urls';
interface Props {
    site: SiteConfig;
}
const { site } = Astro.props;
---

<footer class="ap-footer">
    <div class="ap-footer__inner site-shell">
        <p class="ap-footer__text">
            <img
                class="ap-footer__logo"
                src={logoUrl}
                alt=""
                width="24"
                height="24"
            />
            <span>{site.footer.text}</span>
        </p>
        <nav aria-label="Fußnavigation">
            <ul class="ap-footer__links">
                {site.footer.links.map((link) => (
                    <li>
                        <a href={contentHref(link.href, site)}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</footer>
