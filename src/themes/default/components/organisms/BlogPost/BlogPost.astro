---
import type { CollectionEntry } from 'astro:content';
import type { AssembledPage } from '../../../../../lib/astropilot/pages.js';
import type { SiteConfig } from '../../../../../lib/astropilot/types.js';
import PageLayout from '../../../layouts/PageLayout/PageLayout.astro';
import Hero from '../Hero/Hero.astro';
import Section from '../Section/Section.astro';

type BlogPage = CollectionEntry<'blogPages'>;
type BlogDocument = CollectionEntry<'blogDocuments'>;
type RenderedContent = Awaited<
    ReturnType<typeof import('astro:content').render>
>['Content'];

interface Props {
    post: AssembledPage<BlogPage, BlogDocument>;
    site: SiteConfig;
    HeroContent: RenderedContent;
    sections: { section: BlogDocument; Content: RenderedContent }[];
}

const { post, site, HeroContent, sections } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(site.language, {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
});
---

<PageLayout
    site={site}
    title={post.entry.data.title}
    description={post.entry.data.description}
    route={post.route}
>
    <div class="ap-blog-post">
        <Hero hero={post.hero!} site={site} Content={HeroContent}>
            <time
                slot="meta"
                class="ap-hero__meta"
                datetime={post.entry.data.pubDate.toISOString()}
            >
                {dateFormatter.format(post.entry.data.pubDate)}
            </time>
        </Hero>
        {sections.map(({ section, Content }) => (
            <Section section={section} Content={Content} />
        ))}
    </div>
</PageLayout>
