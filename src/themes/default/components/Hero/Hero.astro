---
import type { CollectionEntry } from 'astro:content';
import { toneOf } from '../../../../lib/astropilot/pages';

interface Props { title: string; hero: CollectionEntry<'documents'>; Content: Awaited<ReturnType<typeof import('astro:content').render>>['Content']; }
const { title, hero, Content } = Astro.props;
const toneClass = { default: 'tone-default', muted: 'tone-muted', brand: 'tone-brand' }[toneOf(hero)];
---
<section class:list={[toneClass, 'ap-hero']} aria-labelledby="page-title">
  <div class="ap-hero__inner site-shell">
    {hero.data.eyebrow && <p class="ap-hero__eyebrow">{hero.data.eyebrow}</p>}
    <h1 id="page-title" class="ap-hero__title">{title}</h1>
    <div class="ap-hero__content content-prose"><Content /></div>
  </div>
</section>
