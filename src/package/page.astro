---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { assemblePages, type AssembledPage } from '../lib/sproutsite/pages.js';
import { loadSiteConfig } from '../lib/sproutsite/site-config.js';
import { blogRouteFromId } from '../lib/sproutsite/urls.js';
import PageLayout from '../themes/default/layouts/PageLayout/PageLayout.astro';
import BlogIndex from '../themes/default/components/organisms/BlogIndex/BlogIndex.astro';
import BlogPost from '../themes/default/components/organisms/BlogPost/BlogPost.astro';
import Hero from '../themes/default/components/organisms/Hero/Hero.astro';
import PageTitle from '../themes/default/components/organisms/PageTitle/PageTitle.astro';
import Section from '../themes/default/components/organisms/Section/Section.astro';

type Locale = 'en' | 'de';

export function localeOf(id: string): Locale {
    return id.endsWith('.de') ? 'de' : 'en';
}

export function logicalId(id: string): string {
    return id.replace(/\.de$/, '');
}

export async function getSproutsiteStaticPaths(locale: Locale = 'en') {
    const pages = assemblePages(
        (await getCollection('pages')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        (await getCollection('documents')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        undefined,
        (entry) => logicalId(entry.id),
    );
    const pagePaths = pages.map((page) => ({
        params: {
            slug: page.route === '/' ? undefined : page.route.slice(1, -1),
        },
        props: { page, locale },
    }));
    const posts = (await getCollection('blogPages'))
        .filter((entry) => localeOf(entry.id) === locale)
        .sort(
            (left, right) =>
                right.data.pubDate.getTime() - left.data.pubDate.getTime(),
        );
    const assembledPosts = assemblePages(
        posts,
        (await getCollection('blogDocuments')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        (entry) => blogRouteFromId(logicalId(entry.id)),
        (entry) => logicalId(entry.id),
    );
    const blogPaths = [
        {
            params: { slug: 'blog' },
            props: { blogIndex: true, posts, locale },
        },
        ...assembledPosts.map((post) => ({
            params: { slug: post.route.slice(1, -1) },
            props: { post, locale },
        })),
    ];
    return [...pagePaths, ...blogPaths];
}

interface Props {
    locale: Locale;
    page?: AssembledPage;
    blogIndex?: boolean;
    posts?: CollectionEntry<'blogPages'>[];
    post?: AssembledPage<
        CollectionEntry<'blogPages'>,
        CollectionEntry<'blogDocuments'>
    >;
}
const { page, blogIndex, posts, post, locale } = Astro.props;
const site = loadSiteConfig(locale);
const hero = page?.hero ? await render(page.hero) : undefined;
const sections = page
    ? await Promise.all(
          page.sections.map(async (section) => ({
              section,
              rendered: await render(section),
          })),
      )
    : [];
const postHero = post?.hero ? await render(post.hero) : undefined;
const postSections = post
    ? await Promise.all(
          post.sections.map(async (section) => ({
              section,
              Content: (await render(section)).Content,
          })),
      )
    : [];
---

{page ? (
    <PageLayout
        site={site}
        title={page.entry.data.title}
        description={page.entry.data.description}
        route={page.route}
        layout={page.entry.data.layout}
    >
        {hero ? (
            <Hero hero={page.hero!} site={site} Content={hero.Content} />
        ) : page.entry.data.layout !== 'landing' ? (
            <PageTitle
                title={page.entry.data.title}
                classes={site.heroClasses}
            />
        ) : null}
        {sections.map(({ section, rendered }) => (
            <Section section={section} Content={rendered.Content} />
        ))}
    </PageLayout>
) : blogIndex && posts ? (
    <BlogIndex posts={posts} site={site} />
) : post && postHero ? (
    <BlogPost
        post={post}
        site={site}
        HeroContent={postHero.Content}
        sections={postSections}
    />
) : null}
