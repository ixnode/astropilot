---
import { getCollection, render } from 'astro:content';
import { assemblePages, type AssembledPage } from '../lib/astropilot/pages.js';
import { loadSiteConfig } from '../lib/astropilot/site-config.js';
import PageLayout from '../themes/default/layouts/PageLayout/PageLayout.astro';
import Hero from '../themes/default/components/organisms/Hero/Hero.astro';
import PageTitle from '../themes/default/components/organisms/PageTitle/PageTitle.astro';
import Section from '../themes/default/components/organisms/Section/Section.astro';

export async function getAstroPilotStaticPaths() {
    const pages = assemblePages(
        await getCollection('pages'),
        await getCollection('documents'),
    );
    return pages.map((page) => ({
        params: {
            slug: page.route === '/' ? undefined : page.route.slice(1, -1),
        },
        props: { page },
    }));
}

interface Props {
    page: AssembledPage;
}
const { page } = Astro.props;
const site = loadSiteConfig();
const hero = page.hero ? await render(page.hero) : undefined;
const sections = await Promise.all(
    page.sections.map(async (section) => ({
        section,
        rendered: await render(section),
    })),
);
---

<PageLayout
    site={site}
    title={page.entry.data.title}
    description={page.entry.data.description}
    route={page.route}
>
    {hero ? (
        <Hero hero={page.hero!} site={site} Content={hero.Content} />
    ) : (
        <PageTitle title={page.entry.data.title} classes={site.heroClasses} />
    )}
    {sections.map(({ section, rendered }) => (
        <Section section={section} Content={rendered.Content} />
    ))}
</PageLayout>
