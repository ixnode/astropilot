---
import Badge from '../../../src/themes/default/components/atoms/Badge/Badge.astro';

type BadgeVariant =
    | 'default'
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'neutral'
    | 'info'
    | 'success'
    | 'warning'
    | 'error';
type BadgeStyle = 'solid' | 'outline' | 'soft' | 'dash';
type BadgeSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl';

/** Storybook adapter that exposes the Badge default slot as a text control. */
interface Props {
    /** Visible text inside the badge. */
    label?: string;
    /** Semantic color variant. */
    variant?: BadgeVariant;
    /** Visual treatment independent of the color variant. */
    style?: BadgeStyle;
    /** Badge size. */
    size?: BadgeSize;
}

const {
    label = 'Default',
    variant = 'default',
    style = 'solid',
    size = 'md',
} = Astro.props;
---

<Badge variant={variant} style={style} size={size}>
    {label}
</Badge>
