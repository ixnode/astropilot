---
import Column from '../../../src/themes/default/components/layout/Column/Column.astro';
import Columns from '../../../src/themes/default/components/layout/Columns/Columns.astro';

type Layout = 'single' | 'two' | 'three' | 'four';

interface Props {
    layout?: Layout;
}

const { layout = 'two' } = Astro.props;
const spans: Record<Layout, number[]> = {
    single: [12],
    two: [6, 6],
    three: [4, 4, 4],
    four: [3, 3, 3, 3],
};
---

<Columns>
    {spans[layout].map((span, index) => (
        <Column span={span}>
            <article class="rounded-box bg-base-200 p-6">
                <h3 class="m-0 text-lg font-bold">Column {index + 1}</h3>
                <p class="mt-3 mb-0">
                    {span} of 12 columns on desktop, stacked on smaller screens.
                </p>
            </article>
        </Column>
    ))}
</Columns>
